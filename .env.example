# ── LLM Backend ───────────────────────────────────────────────
# Choose one: ollama (free local), openai, nvidia_nim
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI (if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# NVIDIA NIM (if LLM_PROVIDER=nvidia_nim) — free tier available
NVIDIA_API_KEY=nvapi-...
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# ── Database ──────────────────────────────────────────────────
POSTGRES_URL=postgresql://concord:concord@localhost:5432/concord
REDIS_URL=redis://localhost:6379

# ── Webhook ───────────────────────────────────────────────────
WEBHOOK_SECRET=changeme

# ── Concord API URL (for CLI) ─────────────────────────────────
CONCORD_API_URL=http://localhost:8000

# ── Connector tokens ─────────────────────────────────────────
TERRASECURE_TOKEN=
TRIVY_TOKEN=
KAGENT_TOKEN=
HOLMESGPT_TOKEN=
