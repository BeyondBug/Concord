# ── Concord Environment Variables ─────────────────────────────────

# LLM Backend
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# OPENAI_API_KEY=sk-...
# NVIDIA_API_KEY=nvapi-...

# Database
POSTGRES_URL=postgresql://concord:concord@localhost:5432/concord
REDIS_URL=redis://localhost:6379

# Webhook
WEBHOOK_SECRET=changeme

# ── GitHub Integration (required for real issue creation) ─────────
# Create at: https://github.com/settings/tokens
# Scopes needed: repo (to create issues on crms-devops/crms)
GITHUB_TOKEN=your_github_personal_access_token

# ── Connector tokens ──────────────────────────────────────────────
TERRASECURE_TOKEN=
TRIVY_TOKEN=
KAGENT_TOKEN=
HOLMESGPT_TOKEN=

# ── Concord API URL (for CLI) ─────────────────────────────────────
CONCORD_API_URL=http://localhost:8000
